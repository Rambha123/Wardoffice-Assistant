# =========================
# App
# =========================
APP_NAME=Ward Office Assistant
ENVIRONMENT=development          # development | production
DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:5173

# =========================
# Database (PostgreSQL)
# =========================
POSTGRES_USER=ward_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ward_office_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://ward_admin:changeme@localhost:5432/ward_office_assistant

# =========================
# Auth (JWT)
# =========================
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =========================
# LLM (Gemini)
# =========================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# =========================
# Embeddings (BGE-M3, local)
# =========================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu             # cpu | cuda

# =========================
# Vector DB (ChromaDB)
# =========================
CHROMA_PERSIST_DIR=./data/indexes
CHROMA_COLLECTION_NAME=ward_knowledge_base
CHROMA_HOST=localhost
CHROMA_PORT=8001

# =========================
# OCR (PaddleOCR)
# =========================
OCR_LANG=en                      # en | ne (nepali) - confirm PaddleOCR language pack
OCR_USE_GPU=false

# =========================
# File uploads
# =========================
MAX_UPLOAD_SIZE_MB=10
TMP_UPLOAD_DIR=./backend/tmp_uploads

# =========================
# Frontend
# =========================
VITE_API_BASE_URL=http://localhost:8000/api
